# Postgres. Locally this is the Docker container from docker-compose.yml (port 5433, so it can run beside the main project's Postgres on 5432):
#   postgresql://postgres:postgres@localhost:5433/cms
#
# In production, a managed provider (Neon) gives two connection strings. The
# pooled one (hostname contains "-pooler") serves the running app; the direct
# one is used by `payload migrate`, because schema changes want a real session
# rather than a transaction-mode pooler. Keep ?sslmode=require on both.
#
# DATABASE_URI must point at a local host in development. `npm run dev` syncs
# the schema into whatever it finds here, so a deployed connection string left
# in this file rewrites that database. payload.config.ts refuses to start
# rather than let that happen; PAYLOAD_ALLOW_REMOTE_PUSH=true overrides it,
# and there is no ordinary reason to set that.
DATABASE_URI=
DATABASE_URI_UNPOOLED=

# Signs admin sessions. Changing it logs everyone out.
PAYLOAD_SECRET=

# SMTP — delivers the .docx that /submit generates. Gmail: create an App
# Password (Google Account → Security → 2-Step Verification → App passwords),
# use it as SMTP_PASS, and set SMTP_USER to the same Gmail address. EMAIL_FROM
# must be an address the SMTP account is allowed to send as. Leave SMTP_USER
# empty and the form still works: submissions are saved and shown in the admin
# panel with "Лист надіслано" unchecked — only the email is skipped.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=
# Where generated profiles are emailed. Defaults to the collector's address.
PROFILE_INBOX=mihov.yurij@gmail.com

# Cloudflare R2. Optional locally — leave R2_BUCKET empty and uploads go to the
# ./media directory on disk instead. Required in production: on Vercel the
# filesystem is read-only and ephemeral, so without R2 every uploaded photo is
# lost on the next deploy.
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket's public origin: a custom domain, or the r2.dev subdomain.
# No trailing slash. Read at build time.
R2_PUBLIC_URL=

# scripts/export.mjs — optional. The three content collections are readable
# without authentication (the same `read: () => true` the main project has),
# so these are only needed if you later lock reads down.
EXPORT_URL=
EXPORT_EMAIL=
EXPORT_PASSWORD=
